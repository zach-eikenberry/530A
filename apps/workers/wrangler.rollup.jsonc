{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "530a-rollup",
  "main": "src/rollup.ts",
  "compatibility_date": "2026-07-01",
  // Personal account only — verify with `wrangler whoami` before deploying.
  "account_id": "fd89fcd385cb37ed871df05e3c7eb10b",
  "vars": {
    "ACCOUNT_ID": "fd89fcd385cb37ed871df05e3c7eb10b",
    // Ingest-only DSN — public by design (the web bundle ships the same one).
    "SENTRY_DSN": "https://e580ebe794d11b0cf23cdad69b078221@o4511725472514048.ingest.us.sentry.io/4511725477691392"
  },
  // Daily at 09:10 UTC — after a full UTC day of events has settled.
  "triggers": { "crons": ["10 9 * * *"] },
  // KV namespace must be created once (`wrangler kv namespace create STATS_KV`)
  // and its id filled in before first deploy. AE_API_TOKEN is a secret:
  // `wrangler secret put AE_API_TOKEN --config wrangler.rollup.jsonc`.
  "kv_namespaces": [
    {
      "binding": "STATS_KV",
      "id": "TBD-create-before-deploy"
    }
  ]
}
