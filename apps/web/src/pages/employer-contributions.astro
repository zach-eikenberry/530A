---
import { CANONICAL_LINKS, pageFaqs, RULES_VERIFIED_AT } from '@530a/config'
import FaqAccordion from '../components/FaqAccordion.astro'
import Base from '../layouts/Base.astro'
import { articleLd, faqPageLd } from '../lib/seo'

const title = '530A Employer Contributions — the $2,500 benefit explained'
const description =
  'How employer contributions to 530A “Trump Accounts” work: up to $2,500/yr per child, counted inside the $5,000 cap — what parents should ask for and what employers should know.'

const faqs = pageFaqs['employer-contributions']
const faqLd = faqPageLd(faqs, '/employer-contributions')
const pageLd = articleLd({ headline: title, description, path: '/employer-contributions' })
---

<Base
  title={title}
  description={description}
  path="/employer-contributions"
  jsonLd={[pageLd, faqLd]}
  ogType="article"
>
  <section class="section-tight" style="background: linear-gradient(180deg, var(--navy-800), var(--navy-900)); color: #fff;">
    <div class="container">
      <span class="eyebrow" style="color: var(--gold-400);">Employer contributions</span>
      <h1 class="mt-2" style="color: #fff;">The $2,500 employer benefit</h1>
      <p class="lead mt-2" style="color: #b9c9e0; max-width: 66ch;">
        Employers can put up to <strong style="color: #fff;">$2,500 per child per year</strong>
        into a 530A, inside the $5,000 combined cap. Verified as of {RULES_VERIFIED_AT} against
        the <a href={CANONICAL_LINKS.statute} style="color: var(--gold-400);">statute</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <FaqAccordion faqs={faqs} />

      <div class="callout mt-4">
        <strong>Model it.</strong> The <a href="/model">Advanced Model</a> supports an employer
        contribution source alongside family and gifts, enforces the caps in source order, and
        shows exactly what an employer match adds by 18 — and by 65. Timing questions are
        covered in <a href="/contribution-deadline">contribution dates &amp; deadlines</a>.
      </div>

      <div class="center mt-4">
        <a class="btn btn-gold btn-lg" href="/model">Add an employer source →</a>
      </div>
    </div>
  </section>
</Base>
