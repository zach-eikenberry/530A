---
import { CANONICAL_LINKS, pageFaqs, RULES_VERIFIED_AT } from '@530a/config'
import FaqAccordion from '../components/FaqAccordion.astro'
import Base from '../layouts/Base.astro'
import { articleLd, faqPageLd } from '../lib/seo'

const title = '530A Withdrawal Rules — when can the money come out?'
const description =
  'When 530A “Trump Account” money can be withdrawn: nothing before 18, Traditional-IRA rules after, penalty-free at 59½, and how basis, taxes, and the Roth conversion work.'

const faqs = pageFaqs.withdrawals
const faqLd = faqPageLd(faqs, '/withdrawals')
const pageLd = articleLd({ headline: title, description, path: '/withdrawals' })
---

<Base
  title={title}
  description={description}
  path="/withdrawals"
  jsonLd={[pageLd, faqLd]}
  ogType="article"
>
  <section class="section-tight" style="background: linear-gradient(180deg, var(--navy-800), var(--navy-900)); color: #fff;">
    <div class="container">
      <span class="eyebrow" style="color: var(--gold-400);">Withdrawal rules</span>
      <h1 class="mt-2" style="color: #fff;">When can 530A money come out?</h1>
      <p class="lead mt-2" style="color: #b9c9e0; max-width: 66ch;">
        The short answer: not before 18, and after that it follows Traditional-IRA rules. The
        details — verified as of {RULES_VERIFIED_AT} against the
        <a href={CANONICAL_LINKS.statute} style="color: var(--gold-400);">statute</a> and
        <a href={CANONICAL_LINKS.irsNotice} style="color: var(--gold-400);">IRS Notice 2025-68</a> —
        are below.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <FaqAccordion faqs={faqs} />

      <div class="callout mt-4">
        <strong>The timeline at a glance.</strong> Locked until 18 → Traditional-IRA treatment
        (taxable withdrawals, IRA rules) → penalty-free at 59½ — or convert to a Roth IRA after
        18 and pay the tax once. Unverified items (the exact early-withdrawal penalty, 529
        rollover) are flagged, never assumed. See the <a href="/glossary">glossary</a> for any
        term, or <a href="/model">model both at-18 paths</a> with your own numbers.
      </div>

      <div class="center mt-4">
        <a class="btn btn-gold btn-lg" href="/model">See what the lock-up earns →</a>
      </div>
    </div>
  </section>
</Base>
