---
import { RULES_VERIFIED_AT } from '@530a/config'
import { updates } from '../data/updates'
import Base from '../layouts/Base.astro'
import { anchorId, articleLd, humanDate } from '../lib/seo'

const title = '530A Model Updates — what changed and when'
const description =
  'A dated log of every meaningful change to 530amodel.com: rule re-verifications, new guides, calculator features, and API/MCP releases.'

const pageLd = {
  ...articleLd({ headline: title, description, path: '/updates' }),
  dateModified: updates[0]?.date ?? RULES_VERIFIED_AT,
}
---

<Base title={title} description={description} path="/updates" jsonLd={[pageLd]} ogType="article">
  <section class="section-tight" style="background: linear-gradient(180deg, var(--navy-800), var(--navy-900)); color: #fff;">
    <div class="container">
      <span class="eyebrow" style="color: var(--gold-400);">Changelog</span>
      <h1 class="mt-2" style="color: #fff;">Updates</h1>
      <p class="lead mt-2" style="color: #b9c9e0; max-width: 66ch;">
        530A rules are young and still evolving — this log records every rule re-verification
        and site change, dated. Rules last verified
        <time datetime={RULES_VERIFIED_AT}>{humanDate(RULES_VERIFIED_AT)}</time>.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container container-narrow prose">
      {updates.map((u) => {
        const id = anchorId(`${u.date}-${u.title}`)
        return (
          <div class="mt-3 update-entry" id={id}>
            <p class="muted" style="margin-bottom: 2px; font-size: 0.85rem;">
              <time datetime={u.date}>{humanDate(u.date)}</time>
            </p>
            <h2 style="font-size: 1.15rem; margin-top: 0;">
              {u.title}
              <a class="anchor-link" href={`#${id}`} aria-label={`Link to “${u.title}”`}>#</a>
            </h2>
            <p>{u.text}</p>
          </div>
        )
      })}
      <p class="mt-4 muted">
        Watching for the Treasury regulations (originally anticipated March 2026, still pending
        as of our last review)? They will settle the flagged items on the
        <a href="/resources">resources page</a>; re-verifications land here first.
      </p>
      <p class="mt-2">
        While you wait: <a href="/model">model a scenario</a> or check the
        <a href="/faq">FAQ</a> for what's already settled.
      </p>
    </div>
  </section>
</Base>
